# Required runtime configuration

DB_URL=jdbc:postgresql://HOST:5432/DATABASE
DB_USERNAME=DATABASE_USER
DB_PASSWORD=DATABASE_PASSWORD
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=https://your-backend.onrender.com
APP_FRONTEND_URL=https://hackverse.netlify.app
APP_QR_URL_BASE=https://your-backend.onrender.com
APP_CORS_ALLOWED_ORIGINS=https://hackverse.netlify.app

# Render persistent disk mount path (or configure external object storage instead)
APP_UPLOAD_DIR=/app/storage/uploads

# Optional services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail: use the full Gmail address, a Google App Password (not your normal
# password), and set SMTP_FROM to the same verified address.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
# For Gmail set this to smtp.gmail.com. Leave blank for other providers unless needed.
SMTP_SSL_TRUST=smtp.gmail.com
SMTP_DEBUG=false

# Optional one-time first administrator. Disable after the account is created.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
